# Environment Variables

# Required before credentials can be saved per brand in the dashboard.
# Generate once with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep this stable and outside the database; changing it makes saved credentials unreadable.
WORKSPACE_SECRET_KEY=

# AI API Keys (configure at least one)
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
AZURE_OPENAI_API_KEY=xxx
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
GOOGLE_API_KEY=xxx
MINIMAX_API_KEY=xxx
DASHSCOPE_API_KEY=xxx
DOUBAO_API_KEY=xxx
DEEPSEEK_API_KEY=xxx

# Optional, review-first featured-image generation (never runs automatically)
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_PROVIDER=openai
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1

# Ollama Cloud (required for CodeQuest article drafting; local Ollama is not used)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=xxx
OLLAMA_MODEL_RESEARCH=your-cloud-research-model
OLLAMA_MODEL_WRITER=your-cloud-writer-model
# Optional; social drafting falls back to OLLAMA_MODEL_WRITER
OLLAMA_MODEL_SOCIAL=your-cloud-social-model
OLLAMA_MODEL_SCORER=your-cloud-scorer-model
OLLAMA_MODEL_FACT_CHECKER=your-cloud-fact-checker-model

# Discord advisory feedback (optional; final approval stays in the workspace)
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_APPROVAL_CHANNEL_ID=your-channel-id
DISCORD_APPLICATION_PUBLIC_KEY=your-application-public-key

# WordPress draft delivery (use a dedicated, revocable Application Password)
WORDPRESS_BASE_URL=https://your-wordpress-site.example
WORDPRESS_USERNAME=your-wordpress-username
WORDPRESS_APP_PASSWORD=your-application-password
WORDPRESS_DRY_RUN=true

# Buffer GraphQL delivery (preview-only by default)
BUFFER_ACCESS_TOKEN=your-personal-api-key
BUFFER_CHANNEL_ID_LINKEDIN=your-linkedin-channel-id
BUFFER_CHANNEL_ID_X=your-x-channel-id
BUFFER_CHANNEL_ID_FACEBOOK=your-facebook-channel-id
BUFFER_SCHEDULE_TIMEZONE=Africa/Johannesburg
BUFFER_DRY_RUN=true

# Editorial automation (disabled until deliberately enabled)
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_MINUTES=1440
AUTOMATION_LOOKBACK_HOURS=48
AUTOMATION_MAX_CANDIDATES=5
AUTOMATION_AUTO_SELECT_COUNT=1
# Drafting can use model credits, so it is independently opt-in
AUTOMATION_AUTO_GENERATE=false
AUTOMATION_DISCOVERY_CONFIG=data/config.json

# WebHook Url (optional for sending notifications)
HORIZON_WEBHOOK_URL=https://xxx

# GitHub Token (optional but recommended for higher rate limits)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
GITHUB_TOKEN=ghp_xxx

# Apify Token (required for Twitter scraping)
# Get yours at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxx
